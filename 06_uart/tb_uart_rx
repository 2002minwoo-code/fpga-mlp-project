`timescale 1ns/1ps
`default_nettype none

module tb_uart_rx;

    // 0: 실제 설정과 같은 868클록/비트
    // 1: 빠르게 관찰하기 위한 16클록/비트
    localparam integer FAST_SIM = 0;

    localparam integer CLK_FREQ_HZ = 100_000_000;
    localparam integer BAUD_RATE   = 115_200;

    localparam integer CLKS_PER_BIT =
        FAST_SIM ? 16 : (CLK_FREQ_HZ / BAUD_RATE);

    localparam integer CLK_PERIOD_NS = 10;
    localparam integer BIT_TIME_NS =
        CLKS_PER_BIT * CLK_PERIOD_NS;

    reg clk = 1'b0;
    always #5 clk = ~clk;  // 100 MHz

    reg rst_n   = 1'b0;
    reg rx_i    = 1'b1;
    reg ready_i = 1'b0;

    wire [39:0] features_o;
    wire        valid_o;
    wire        error_o;

    integer error_count = 0;
    integer valid_count = 0;

    // 파형에서 현재 테스트 구분
    integer test_no = 0;

    // 현재 TB가 송신 중인 바이트
    reg [7:0] tx_byte = 8'h00;
    reg       sending_byte = 1'b0;

    // 0: 대기, 1: 시작, 2: 데이터, 3: 정지
    reg [1:0] tx_phase = 2'd0;
    reg [2:0] tx_bit_index = 3'd0;

    uart_packet_rx #(
        .N_FEATURES  (5),
        .FEATURE_W   (8),
        .CLK_FREQ_HZ (CLK_FREQ_HZ),
        .BAUD_RATE   (BAUD_RATE),
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) dut (
        .clk       (clk),
        .rst_n     (rst_n),
        .rx_i      (rx_i),
        .features_o(features_o),
        .valid_o   (valid_o),
        .ready_i   (ready_i),
        .error_o   (error_o)
    );

    // ----------------------------------------
    // 파형 관찰용 신호
    // DUT 내부 신호를 읽기만 하며 동작에는 영향 없음
    // ----------------------------------------

    wire [1:0] rx_state;
    wire [1:0] packet_state;
    wire [2:0] rx_bit_index;
    wire [7:0] rx_shift;
    wire [7:0] received_byte;
    wire       byte_valid;
    wire       byte_error;
    wire [7:0] checksum;
    wire [39:0] features_work;

    assign rx_state      = dut.u_uart_rx.state;
    assign packet_state  = dut.state;
    assign rx_bit_index  = dut.u_uart_rx.bit_index;
    assign rx_shift      = dut.u_uart_rx.shift_reg;
    assign received_byte = dut.byte_data;
    assign byte_valid    = dut.byte_valid;
    assign byte_error    = dut.byte_error;
    assign checksum      = dut.checksum;
    assign features_work = dut.features_work;

    // 최종 Feature를 각각 나누어 관찰
    wire [7:0] feature0;
    wire [7:0] feature1;
    wire [7:0] feature2;
    wire [7:0] feature3;
    wire [7:0] feature4;

    assign feature0 = features_o[ 7: 0];
    assign feature1 = features_o[15: 8];
    assign feature2 = features_o[23:16];
    assign feature3 = features_o[31:24];
    assign feature4 = features_o[39:32];

    // 오류 횟수와 실제 패킷 전달 횟수
    always @(posedge clk) begin
        if (!rst_n) begin
            error_count <= 0;
            valid_count <= 0;
        end else begin
            if (error_o)
                error_count <= error_count + 1;

            if (valid_o && ready_i)
                valid_count <= valid_count + 1;
        end
    end

    // ----------------------------------------
    // UART 바이트 전송
    // bad_stop=1이면 정지 비트를 0으로 만들어 오류 발생
    // ----------------------------------------

    task automatic send_byte(
        input [7:0] value,
        input       bad_stop
    );
        integer i;
        begin
            @(negedge clk);

            tx_byte      = value;
            sending_byte = 1'b1;
            tx_bit_index = 3'd0;

            // 시작 비트
            tx_phase = 2'd1;
            rx_i = 1'b0;
            #(BIT_TIME_NS);

            // 데이터 비트: LSB부터
            tx_phase = 2'd2;

            for (i = 0; i < 8; i = i + 1) begin
                tx_bit_index = i;
                rx_i = value[i];
                #(BIT_TIME_NS);
            end

            // 정지 비트
            tx_phase = 2'd3;
            rx_i = bad_stop ? 1'b0 : 1'b1;
            #(BIT_TIME_NS);

            // 대기 상태로 복귀
            rx_i         = 1'b1;
            sending_byte = 1'b0;
            tx_phase     = 2'd0;

            // 바이트 사이 대기: 파형 구분 및 오류 후 복귀
            #(BIT_TIME_NS);
        end
    endtask

    // ----------------------------------------
    // A5 + Feature 5바이트 + XOR 체크섬
    // ----------------------------------------

    task automatic send_packet(
        input [7:0] f0,
        input [7:0] f1,
        input [7:0] f2,
        input [7:0] f3,
        input [7:0] f4,
        input       corrupt_checksum
    );
        reg [7:0] check;
        begin
            check = f0 ^ f1 ^ f2 ^ f3 ^ f4;

            send_byte(8'hA5, 1'b0);
            send_byte(f0,    1'b0);
            send_byte(f1,    1'b0);
            send_byte(f2,    1'b0);
            send_byte(f3,    1'b0);
            send_byte(f4,    1'b0);

            send_byte(
                check ^ {7'b0, corrupt_checksum},
                1'b0
            );
        end
    endtask

    // ----------------------------------------
    // 정상 패킷 확인 → 유지 확인 → 수락
    // hold_bits는 기다릴 시간을 비트 시간 단위로 지정
    // ----------------------------------------

    task automatic check_and_accept(
        input [39:0] expected,
        input integer hold_bits
    );
        integer previous_count;
        integer k;
        begin
            repeat (5) @(negedge clk);

            if (valid_o !== 1'b1 ||
                features_o !== expected)
                $fatal(
                    1,
                    "Test %0d: expected=%h actual=%h valid=%b",
                    test_no, expected, features_o, valid_o
                );

            // ready=0인 동안 매 클록 출력 유지 검사
            for (k = 0;
                 k < hold_bits * CLKS_PER_BIT;
                 k = k + 1) begin

                @(negedge clk);

                if (valid_o !== 1'b1 ||
                    features_o !== expected)
                    $fatal(
                        1,
                        "Test %0d: HOLD failed",
                        test_no
                    );
            end

            previous_count = valid_count;

            // 다음 상승 에지에서 패킷 수락
            ready_i = 1'b1;
            @(negedge clk);
            ready_i = 1'b0;
            @(negedge clk);

            if (valid_o !== 1'b0 ||
                valid_count != previous_count + 1)
                $fatal(
                    1,
                    "Test %0d: handshake failed",
                    test_no
                );

            // 다음 패킷과 구분되는 대기 구간
            repeat (2 * CLKS_PER_BIT) @(negedge clk);
        end
    endtask

    // ----------------------------------------
    // 테스트 시나리오
    // ----------------------------------------

    initial begin
        repeat (10) @(negedge clk);
        rst_n = 1'b1;
        repeat (10) @(negedge clk);

        // 1. 비트 변화가 많은 정상 패킷
        test_no = 1;
        send_packet(
            8'h55, 8'hAA, 8'h0F, 8'hF0, 8'h81,
            1'b0
        );
        check_and_accept(40'h81_F0_0F_AA_55, 4);

        // 2. 기존 데이터: 바이트 순서 확인
        test_no = 2;
        send_packet(
            8'h80, 8'h7F, 8'hFF, 8'h00, 8'h12,
            1'b0
        );
        check_and_accept(40'h12_00_FF_7F_80, 8);

        // 3. 잘못된 체크섬
        // 직전 정상 출력은 그대로 유지되어야 함
        test_no = 3;
        send_packet(
            8'h01, 8'h02, 8'h04, 8'h08, 8'h10,
            1'b1
        );
        repeat (10) @(negedge clk);

        if (valid_o !== 1'b0 ||
            error_count != 1 ||
            features_o !== 40'h12_00_FF_7F_80)
            $fatal(1, "Bad checksum handling failed");

        repeat (4 * CLKS_PER_BIT) @(negedge clk);

        // 4. 오류 이후 정상 패킷 복구
        test_no = 4;
        send_packet(
            8'h11, 8'h22, 8'h33, 8'h44, 8'h55,
            1'b0
        );
        check_and_accept(40'h55_44_33_22_11, 4);

        // 5. 패킷 수신 도중 정지 비트 오류
        test_no = 5;
        send_byte(8'hA5, 1'b0);
        send_byte(8'h55, 1'b1);

        repeat (10) @(negedge clk);

        if (valid_o !== 1'b0 ||
            error_count != 2 ||
            features_o !== 40'h55_44_33_22_11)
            $fatal(1, "Bad stop bit handling failed");

        repeat (4 * CLKS_PER_BIT) @(negedge clk);

        // 6. 정지 비트 오류 이후 복구
        // Payload에 A5가 있어도 데이터로 처리되어야 함
        test_no = 6;
        send_packet(
            8'hA5, 8'h5A, 8'hCC, 8'h33, 8'h96,
            1'b0
        );
        check_and_accept(40'h96_33_CC_5A_A5, 6);

        // 7. 추가 정상 패킷
        test_no = 7;
        send_packet(
            8'h01, 8'h03, 8'h07, 8'h0F, 8'h1F,
            1'b0
        );
        check_and_accept(40'h1F_0F_07_03_01, 4);

        if (valid_count != 5 || error_count != 2)
            $fatal(
                1,
                "Final counts: valid=%0d error=%0d",
                valid_count, error_count
            );

        test_no = 8;
        repeat (10 * CLKS_PER_BIT) @(negedge clk);

        $display(
            "PASS: 5 accepted packets, 2 detected errors"
        );
        $finish;
    end

    // 무한 대기 방지: 10 ms
    initial begin
        #10_000_000;
        $fatal(1, "Simulation timeout");
    end

endmodule

`default_nettype wire
