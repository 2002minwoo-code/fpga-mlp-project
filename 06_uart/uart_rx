`timescale 1ns/1ps
`default_nettype none

module tb_uart_rx;
    // 시뮬레이션 시간을 줄이기 위한 값: 1비트 = 10클록
    localparam integer CLK_FREQ_HZ = 10_000_000;
    localparam integer BAUD_RATE   = 1_000_000;
    localparam integer CLKS_PER_BIT = CLK_FREQ_HZ / BAUD_RATE;
    localparam integer BIT_TIME_NS  = CLKS_PER_BIT * 100;

    reg clk = 1'b0;
    always #50 clk = ~clk;  // 10 MHz

    reg rst_n   = 1'b0;
    reg rx_i    = 1'b1;
    reg ready_i = 1'b0;

    wire [39:0] features_o;
    wire        valid_o;
    wire        error_o;

    integer error_count = 0;
    integer valid_count = 0;

    uart_packet_rx #(
        .N_FEATURES (5),
        .FEATURE_W  (8),
        .CLK_FREQ_HZ(CLK_FREQ_HZ),
        .BAUD_RATE  (BAUD_RATE)
    ) dut (
        .clk       (clk),
        .rst_n     (rst_n),
        .rx_i      (rx_i),
        .features_o(features_o),
        .valid_o   (valid_o),
        .ready_i   (ready_i),
        .error_o   (error_o)
    );

    always @(posedge clk) begin
        if (rst_n) begin
            if (error_o) error_count <= error_count + 1;
            if (valid_o && ready_i) valid_count <= valid_count + 1;
        end
    end

    task automatic send_byte(input [7:0] value);
        integer i;
        begin
            @(negedge clk);
            rx_i = 1'b0;                 // start
            #(BIT_TIME_NS);

            for (i = 0; i < 8; i = i + 1) begin
                rx_i = value[i];         // LSB first
                #(BIT_TIME_NS);
            end

            rx_i = 1'b1;                 // stop
            #(BIT_TIME_NS);
        end
    endtask

    task automatic send_packet(
        input [7:0] f0,
        input [7:0] f1,
        input [7:0] f2,
        input [7:0] f3,
        input [7:0] f4,
        input       corrupt_checksum
    );
        reg [7:0] check;
        begin
            check = f0 ^ f1 ^ f2 ^ f3 ^ f4;
            send_byte(8'hA5);
            send_byte(f0);
            send_byte(f1);
            send_byte(f2);
            send_byte(f3);
            send_byte(f4);
            send_byte(check ^ {7'b0, corrupt_checksum});
        end
    endtask

    initial begin
        repeat (5) @(negedge clk);
        rst_n = 1'b1;
        repeat (5) @(negedge clk);

        // 1. 잘못된 체크섬: valid가 올라오면 안 됨
        send_packet(8'h01, 8'h02, 8'h03, 8'h04, 8'h05, 1'b1);
        repeat (5) @(negedge clk);

        if (valid_o !== 1'b0 || error_count != 1)
            $fatal(1, "Bad checksum was not rejected");

        // 2. 정상 패킷: Feature 0이 하위 바이트인지 확인
        send_packet(8'h80, 8'h7F, 8'hFF, 8'h00, 8'h12, 1'b0);
        repeat (5) @(negedge clk);

        if (valid_o !== 1'b1)
            $fatal(1, "Valid packet was not presented");

        if (features_o !== 40'h12_00_FF_7F_80)
            $fatal(1, "Feature order/data mismatch: %h", features_o);

        // ready가 0인 동안 출력이 유지돼야 함
        repeat (20) @(negedge clk);
        if (valid_o !== 1'b1 ||
            features_o !== 40'h12_00_FF_7F_80)
            $fatal(1, "valid/features did not hold");

        // fpga_top의 패킷 수락 동작
        ready_i = 1'b1;
        @(negedge clk);
        ready_i = 1'b0;
        @(negedge clk);

        if (valid_o !== 1'b0 || valid_count != 1)
            $fatal(1, "Ready/valid handshake failed");

        // 3. 수락 후 다음 패킷도 받을 수 있어야 함
        send_packet(8'h11, 8'h22, 8'h33, 8'h44, 8'h55, 1'b0);
        repeat (5) @(negedge clk);

        if (valid_o !== 1'b1 ||
            features_o !== 40'h55_44_33_22_11)
            $fatal(1, "Second packet failed");

        $display("PASS: checksum rejection, byte order, hold, handshake, next packet");
        $finish;
    end

    initial begin
        #2_000_000;
        $fatal(1, "Simulation timeout");
    end
endmodule

`default_nettype wire
