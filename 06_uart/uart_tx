
`timescale 1ns/1ps

// UART 송신기 (8N1 방식)
// 8N1: 데이터 8비트, 패리티 없음, 정지 비트 1비트
// 전송 순서: 시작 비트(0) → 데이터 8비트(LSB부터) → 정지 비트(1)
//
// rst: 클록 상승 에지에서 동작하는 동기식 초기화 신호 (1일 때 초기화)
// tx_start: 전송 시작 요청 신호 (1클록 동안만 1로 설정)
// tx_busy: 송신 중일 때 1, 새로운 데이터를 받을 수 있을 때 0
//
// 송신 중 들어온 새로운 전송 요청은 무시하며 별도의 대기열은 없음.

module uart_tx #(
    // UART 데이터 1비트를 유지하기 위해 필요한 클록 수
    // 기본값: 100MHz 클록, 115200 baud 기준 약 868클록
    parameter integer CLKS_PER_BIT = 868
)(
    input  logic       clk,       // FPGA에서 공급하는 시스템 클록
    input  logic       rst,       // 동기식 초기화 신호 (Active High)
    input  logic       tx_start,  // 전송 시작 요청
    input  logic [7:0] tx_data,   // 전송할 8비트 데이터
    output logic       tx,        // UART 송신 출력 (대기 상태에서는 1)
    output logic       tx_busy    // UART 송신 진행 상태
);

    // 1비트의 전송 시간을 세는 카운터에 필요한 비트 수
    // 예: CLKS_PER_BIT = 868이면 COUNT_W = 10
    // 10비트로 0부터 867까지 표현할 수 있음
    // CLKS_PER_BIT = 1인 경우에도 최소 1비트를 사용
    localparam integer COUNT_W =
        (CLKS_PER_BIT <= 1) ? 1 : $clog2(CLKS_PER_BIT);

    // 카운터가 도달해야 하는 마지막 값
    // 예: CLKS_PER_BIT = 868이면 LAST_COUNT = 867
    localparam logic [COUNT_W-1:0] LAST_COUNT =
        COUNT_W'(CLKS_PER_BIT - 1);

    // UART 송신기의 동작 상태를 정의
    // IDLE  : 전송 요청 대기
    // START : 시작 비트(0) 전송
    // DATA  : 데이터 8비트 전송
    // STOP  : 정지 비트(1) 전송
    typedef enum logic [1:0] {
        IDLE  = 2'b00,
        START = 2'b01,
        DATA  = 2'b10,
        STOP  = 2'b11
    } state_t;

    state_t state;  // 현재 UART 송신 상태

    // 현재 비트를 유지한 클록 수를 세는 카운터
    logic [COUNT_W-1:0] bit_timer;

    // 현재 전송 중인 데이터 비트의 번호 (0~7)
    logic [2:0] bit_index;

    // 전송 시작 시 입력 데이터를 저장하는 레지스터
    // 전송 중 tx_data가 변해도 현재 전송 데이터는 유지됨
    logic [7:0] data_latched;

    // 모든 상태 및 출력은 클록 상승 에지에서 변경됨
    always_ff @(posedge clk) begin

        // 초기화 신호가 1이면 UART를 대기 상태로 초기화
        if (rst) begin
            state        <= IDLE;
            bit_timer    <= '0;
            bit_index    <= '0;
            data_latched <= '0;
            tx           <= 1'b1;
            tx_busy      <= 1'b0;

        end else begin

            // 현재 상태에 따라 UART 송신 동작 수행
            case (state)

                // =========================================
                // 1. IDLE: 전송 요청을 기다리는 상태
                // =========================================
                IDLE: begin
                    tx        <= 1'b1;
                    tx_busy   <= 1'b0;
                    bit_timer <= '0;
                    bit_index <= '0;

                    // 전송 요청이 들어오면 데이터를 저장하고 송신 시작
                    if (tx_start) begin
                        data_latched <= tx_data;

                        // UART 시작 비트는 0
                        tx      <= 1'b0;
                        tx_busy <= 1'b1;

                        // 시작 비트 전송 상태로 이동
                        state <= START;
                    end
                end

                // =========================================
                // 2. START: 시작 비트(0)를 전송하는 상태
                // =========================================
                START: begin

                    // 시작 비트가 정해진 클록 수만큼 유지되었는지 확인
                    if (bit_timer == LAST_COUNT) begin

                        // 다음 비트 전송을 위해 카운터 초기화
                        bit_timer <= '0;

                        // 데이터의 최하위 비트(bit 0)부터 전송
                        tx <= data_latched[0];

                        // 데이터 전송 상태로 이동
                        state <= DATA;

                    end else begin

                        // 시작 비트 유지 시간을 계산
                        bit_timer <= bit_timer + 1'b1;
                    end
                end

                // =========================================
                // 3. DATA: 데이터 8비트를 순서대로 전송
                // =========================================
                DATA: begin

                    // 현재 데이터 비트의 전송 시간이 끝났는지 확인
                    if (bit_timer == LAST_COUNT) begin

                        // 다음 비트 전송을 위해 카운터 초기화
                        bit_timer <= '0;

                        // 마지막 데이터 비트(bit 7)를 전송한 경우
                        if (bit_index == 3'd7) begin

                            // 데이터 전송 완료 후 정지 비트(1) 출력
                            tx <= 1'b1;

                            // 정지 비트 전송 상태로 이동
                            state <= STOP;

                        end else begin

                            // 다음 데이터 비트 번호로 이동
                            bit_index <= bit_index + 1'b1;

                            // 다음 데이터 비트를 출력
                            // bit_index는 현재 비트 번호이므로 1을 더함
                            tx <= data_latched[bit_index + 3'd1];
                        end

                    end else begin

                        // 현재 데이터 비트의 유지 시간을 계산
                        bit_timer <= bit_timer + 1'b1;
                    end
                end

                // =========================================
                // 4. STOP: 정지 비트(1)를 전송하는 상태
                // =========================================
                STOP: begin

                    // 정지 비트가 정해진 시간만큼 유지되었는지 확인
                    if (bit_timer == LAST_COUNT) begin

                        // 카운터 초기화
                        bit_timer <= '0;

                        // 송신 완료를 표시
                        tx_busy <= 1'b0;

                        // 다음 전송 요청을 받을 수 있도록 대기 상태로 이동
                        state <= IDLE;

                    end else begin

                        // 정지 비트의 유지 시간을 계산
                        bit_timer <= bit_timer + 1'b1;
                    end
                end

                // =========================================
                // 5. 정의되지 않은 상태에 대한 복구 처리
                // =========================================
                default: begin
                    state     <= IDLE;
                    tx        <= 1'b1;
                    tx_busy   <= 1'b0;
                    bit_timer <= '0;
                    bit_index <= '0;
                end

            endcase
        end
    end

endmodule
