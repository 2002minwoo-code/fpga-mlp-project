
`timescale 1ns/1ps
`default_nettype none

// UART 수신기 (8N1 방식)
//
// 8N1:
// 데이터 8비트, 패리티 없음, 정지 비트 1비트
//
// 수신 순서:
// 시작 비트(0) → 데이터 8비트(LSB부터) → 정지 비트(1)
//
// 주요 기능:
// 1. 비동기 UART 입력 신호를 FPGA 클록에 동기화
// 2. 시작 비트 검출 및 중앙에서 유효성 확인
// 3. 각 데이터 비트의 중앙에서 샘플링
// 4. 수신한 8비트를 하나의 바이트로 복원
// 5. 정지 비트 검사 및 오류 검출
// 6. 정상 수신 시 valid_o를 1클록 동안 출력
//
// rst_n   : 비동기식 초기화 (0일 때 초기화)
// rx_i    : 외부에서 들어오는 UART 직렬 데이터
// data_o  : 수신 완료된 8비트 데이터
// valid_o : 정상 수신 완료 신호 (1클록 펄스)
// error_o : 정지 비트 오류 신호 (1클록 펄스)
//
// CLKS_PER_BIT:
// UART 데이터 1비트에 해당하는 시스템 클록 수
//
// 예시:
// 100MHz / 115200baud = 약 868클록
//
// 입력 동기화 지연을 고려하여
// CLKS_PER_BIT는 8 이상 사용 권장

module uart_rx #(
    parameter integer CLK_FREQ_HZ  = 100_000_000,
    parameter integer BAUD_RATE    = 115_200,
    parameter integer CLKS_PER_BIT = CLK_FREQ_HZ / BAUD_RATE
)(
    input  logic       clk,      // FPGA 시스템 클록
    input  logic       rst_n,    // 초기화 신호 (Active Low)
    input  logic       rx_i,     // UART 직렬 입력

    output logic [7:0] data_o,   // 수신 완료된 데이터
    output logic       valid_o,  // 정상 수신 완료 신호
    output logic       error_o   // 수신 오류 신호
);

    // ========================================
    // 1. UART 비트 시간 계산
    // ========================================

    // 비트 시간을 세는 카운터에 필요한 비트 수
    //
    // 예:
    // CLKS_PER_BIT = 868이면 COUNT_W = 10
    // 10비트 카운터로 0부터 867까지 표현 가능
    //
    // CLKS_PER_BIT가 1인 경우에도
    // 최소 1비트 크기의 카운터를 사용
    localparam integer COUNT_W =
        (CLKS_PER_BIT <= 1)
        ? 1 : $clog2(CLKS_PER_BIT);

    // 데이터 1비트의 마지막 카운터 값
    //
    // 예:
    // CLKS_PER_BIT = 868
    // BIT_LAST = 867
    localparam logic [COUNT_W-1:0] BIT_LAST =
        COUNT_W'(CLKS_PER_BIT - 1);

    // 시작 비트 중앙까지 기다리는 시간
    //
    // UART는 비트 경계보다 중앙에서 읽는 것이 안정적
    //
    // 예:
    // CLKS_PER_BIT = 868
    // 절반 = 434클록
    // HALF_LAST = 433
    localparam logic [COUNT_W-1:0] HALF_LAST =
        COUNT_W'((CLKS_PER_BIT / 2) - 1);


    // ========================================
    // 2. UART 수신 상태 정의
    // ========================================

    // IDLE  : 시작 비트를 기다리는 상태
    // START : 시작 비트 중앙에서 0인지 확인
    // DATA  : 데이터 8비트를 수신하는 상태
    // STOP  : 정지 비트가 1인지 확인하는 상태

    typedef enum logic [1:0] {
        IDLE  = 2'b00,
        START = 2'b01,
        DATA  = 2'b10,
        STOP  = 2'b11
    } state_t;

    // 현재 UART 수신 상태
    state_t state;


    // ========================================
    // 3. 내부 레지스터
    // ========================================

    // 비동기 UART 입력을 동기화하기 위한 레지스터
    logic rx_meta;
    logic rx_sync;

    // 현재 비트의 샘플링 시간을 계산하는 타이머
    logic [COUNT_W-1:0] bit_timer;

    // 현재 수신 중인 데이터 비트 번호
    // 0부터 7까지 총 8개 비트
    logic [2:0] bit_index;

    // 수신한 데이터 비트를 임시 저장
    //
    // 예:
    // 첫 번째 데이터 비트 → shift_reg[0]
    // 두 번째 데이터 비트 → shift_reg[1]
    // ...
    // 마지막 데이터 비트 → shift_reg[7]
    //
    // 기존 tb_uart_rx에서 내부 신호를 확인하므로
    // 이름을 shift_reg로 유지
    logic [7:0] shift_reg;


    // ========================================
    // 4. UART 입력 신호 동기화
    // ========================================

    // UART 입력은 FPGA 시스템 클록과
    // 동기화되어 들어온다는 보장이 없음
    //
    // 따라서 2단 플립플롭을 사용하여
    // 메타안정성이 내부 회로에 전달될 위험을 줄임
    //
    // rx_i → rx_meta → rx_sync
    //
    // rx_meta:
    // 외부 신호를 첫 번째 플립플롭에서 저장
    //
    // rx_sync:
    // 두 번째 플립플롭에서 동기화된 값을 저장

    always_ff @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin

            // UART 대기 상태는 1이므로
            // 동기화 레지스터도 1로 초기화
            rx_meta <= 1'b1;
            rx_sync <= 1'b1;

        end else begin

            // 첫 번째 동기화 단계
            rx_meta <= rx_i;

            // 두 번째 동기화 단계
            rx_sync <= rx_meta;

        end
    end


    // ========================================
    // 5. UART 수신 상태기계
    // ========================================

    // 상태와 데이터는 클록 상승 에지에서 갱신
    // rst_n이 0이 되면 비동기적으로 초기화

    always_ff @(posedge clk or negedge rst_n) begin

        // ====================================
        // 초기화
        // ====================================

        if (!rst_n) begin

            state     <= IDLE;

            bit_timer <= '0;
            bit_index <= '0;

            shift_reg <= '0;

            data_o    <= '0;

            valid_o   <= 1'b0;
            error_o   <= 1'b0;

        end else begin

            // 정상 수신 완료 신호와 오류 신호는
            // 발생한 클록에서만 1로 설정
            //
            // 다음 클록에서는 기본적으로 다시 0
            valid_o <= 1'b0;
            error_o <= 1'b0;

            // 현재 상태에 따른 수신 동작
            case (state)

                // =================================
                // 1. IDLE: 시작 비트 대기
                // =================================

                IDLE: begin

                    // 새로운 수신을 위한 초기화
                    bit_timer <= '0;
                    bit_index <= '0;

                    // UART 대기 상태는 1
                    //
                    // 동기화된 입력이 0으로 내려가면
                    // 시작 비트가 들어온 것으로 판단
                    if (rx_sync == 1'b0) begin

                        // 시작 비트의 중앙까지 대기
                        bit_timer <= HALF_LAST;

                        // 시작 비트 확인 상태로 이동
                        state <= START;

                    end
                end


                // =================================
                // 2. START: 시작 비트 확인
                // =================================

                START: begin

                    // 시작 비트 중앙까지 기다렸는지 확인
                    if (bit_timer == 0) begin

                        // 중앙에서도 0이면 정상 시작 비트
                        if (rx_sync == 1'b0) begin

                            // 첫 번째 데이터 비트의
                            // 중앙까지 한 비트 시간 대기
                            bit_timer <= BIT_LAST;

                            // 데이터 수신 상태로 이동
                            state <= DATA;

                        end else begin

                            // 시작 비트 중앙에서 1이면
                            // 짧은 잡음으로 판단
                            //
                            // 해당 시작 신호를 무시하고
                            // 새로운 시작 비트를 기다림
                            state <= IDLE;

                        end

                    end else begin

                        // 시작 비트 중앙까지 남은 시간 감소
                        bit_timer <= bit_timer - 1'b1;

                    end
                end


                // =================================
                // 3. DATA: 데이터 8비트 수신
                // =================================

                DATA: begin

                    // 데이터 비트 중앙에 도달했는지 확인
                    if (bit_timer == 0) begin

                        // 현재 데이터 비트를 저장
                        //
                        // UART는 하위 비트부터 수신하므로
                        // bit_index = 0부터 저장
                        shift_reg[bit_index] <= rx_sync;

                        // 다음 비트 중앙까지 대기
                        bit_timer <= BIT_LAST;

                        // 마지막 데이터 비트인지 확인
                        if (bit_index == 3'd7) begin

                            // 8비트 수신이 모두 끝났으므로
                            // 정지 비트 확인 상태로 이동
                            state <= STOP;

                        end else begin

                            // 다음 데이터 비트 번호로 이동
                            bit_index <= bit_index + 1'b1;

                        end

                    end else begin

                        // 다음 데이터 비트 중앙까지 대기
                        bit_timer <= bit_timer - 1'b1;

                    end
                end


                // =================================
                // 4. STOP: 정지 비트 확인
                // =================================

                STOP: begin

                    // 정지 비트 중앙에 도달했는지 확인
                    if (bit_timer == 0) begin

                        // 정상 정지 비트는 1
                        if (rx_sync == 1'b1) begin

                            // 수신한 8비트 데이터를
                            // 최종 출력 레지스터에 저장
                            data_o <= shift_reg;

                            // 정상 수신 완료 표시
                            // 이 신호는 한 클록 동안 1
                            valid_o <= 1'b1;

                        end else begin

                            // 정지 비트가 0이면
                            // UART 프레이밍 오류 발생
                            //
                            // 잘못된 바이트는 data_o에
                            // 반영하지 않음
                            error_o <= 1'b1;

                        end

                        // 정상 수신 또는 오류 처리 후
                        // 다음 바이트 수신을 위해 대기
                        state <= IDLE;

                    end else begin

                        // 정지 비트 중앙까지 대기
                        bit_timer <= bit_timer - 1'b1;

                    end
                end


                // =================================
                // 5. 비정상 상태 복구
                // =================================

                default: begin

                    // 정의되지 않은 상태가 발생하면
                    // 안전하게 대기 상태로 복귀
                    state     <= IDLE;
                    bit_timer <= '0;
                    bit_index <= '0;

                end

            endcase
        end
    end

endmodule

`default_nettype wire
